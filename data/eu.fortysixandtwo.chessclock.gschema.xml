<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="chess-clock">
	<schema id="eu.fortysixandtwo.chessclock" path="/eu/fortysixandtwo/chessclock/">
	  <key name="width" type="i">
      <default>640</default>
    </key>
    <key name="height" type="i">
      <default>480</default>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
    </key>
	  <key name="custom-control-minutes" type="i">
      <default>5</default>
	  </key>
	  <key name="custom-control-seconds" type="i">
      <default>0</default>
	  </key>
	  <key name="custom-control-increment" type="i">
      <default>0</default>
	  </key>
	  <key name="control-method" type="i">
      <default>0</default>
	  </key>
	  <key name="muted" type="b">
      <default>false</default>
      </key>
    </schema>
</schemalist>
