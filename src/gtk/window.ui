<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="ChessClockWindow" parent="AdwApplicationWindow">
    <property name="default-width">600</property>
    <property name="default-height">300</property>
    <property name="content">
      <object class="GtkStack" id="main_stack">
        <property name="transition-type">crossfade</property>
        <child>
          <object class="GtkWindowHandle">
            <child>
              <object class="GtkOverlay">
                <child type="overlay">
                  <object class="GtkWindowControls">
                    <property name="halign">start</property>
                    <property name="valign">start</property>
                    <property name="side">start</property>
                    <style>
                      <class name="white"/>
                      <class name="small-margin"/>
                    </style>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkWindowControls">
                    <property name="halign">end</property>
                    <property name="valign">start</property>
                    <property name="side">end</property>
                    <style>
                      <class name="black"/>
                      <class name="small-margin"/>
                    </style>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkMenuButton">
                    <property name="halign">center</property>
                    <property name="valign">start</property>
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="menu-model">primary_menu</property>
                    <style>
                      <class name="image-button"/>
                      <class name="circular"/>
                      <class name="osd"/>
                      <class name="small-margin"/>
                    </style>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkButton" id="play-pause">
                    <property name="halign">center</property>
                    <property name="valign">end</property>
                    <property name="icon-name">media-playback-pause-symbolic</property>
                    <style>
                      <class name="image-button"/>
                      <class name="circular"/>
                      <class name="large"/>
                      <class name="osd"/>
                      <class name="small-margin"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <child>
                      <object class="ChessClockTimerButton" id="white_timer">
                        <property name="hexpand">true</property>
                        <style>
                          <class name="white"/>
                          <class name="running"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="ChessClockTimerButton" id="black_timer">
                        <property name="hexpand">true</property>
                        <style>
                          <class name="black"/>
                        </style>
                      </object>
                    </child>
                    <style>
                      <class name="linked"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_New Time Control</attribute>
        <attribute name="action">win.new</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Restart Timer</attribute>
        <attribute name="action">win.restart</attribute>
      </item>
    </section>
    <section>
      <submenu>
        <attribute name="label" translatable="yes">_Increment</attribute>
        <item>
          <attribute name="label" translatable="yes">_Bonus</attribute>
          <attribute name="action">app.increment</attribute>
          <attribute name="target">bonus</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">B_ronstein</attribute>
          <attribute name="action">app.increment</attribute>
          <attribute name="target">bronstein</attribute>
        </item>
        <item>
          <attribute name="label" translatable="yes">_Simple</attribute>
          <attribute name="action">app.increment</attribute>
          <attribute name="target">simple</attribute>
        </item>
      </submenu>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.show-help-overlay</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Chess Clock</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
